{
  "name": "threadnote",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/test-canvas.mjs && node scripts/test-utilities.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "format": "prettier --write src scripts docs *.json *.ts *.js *.md .github/workflows/*.yml && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src scripts docs *.json *.ts *.js *.md .github/workflows/*.yml && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "package:windows": "npm run check && npm run test:native && tauri build --bundles nsis",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-sql": "2.6.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=24 <25"
  }
}
